# Application
APP_ENV=development
APP_NAME=7oz-cafe
APP_PORT=8080
APP_URL=http://localhost:8080

# Frontend (public)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Database
DB_HOST=localhost
DB_PORT=5433
DB_USER=sevenoz
DB_PASSWORD=sevenoz_dev_password
DB_NAME=sevenoz
DB_SSLMODE=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT (development placeholders — replace before staging/production)
JWT_ACCESS_SECRET=dev-access-secret-change-me-min-32-chars
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Seed (development placeholders — replace before staging/production)
SEED_ADMIN_EMAIL=admin@7oz.local
SEED_ADMIN_PASSWORD=ChangeMeNow!123
SEED_ADMIN_NAME=Super Admin

# Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage

# Public website base URL (used in email links)
WEBSITE_URL=http://localhost:3000

# SMTP (optional in development — empty host logs emails instead of sending)
# For local capture, run Mailpit and set SMTP_HOST=localhost SMTP_PORT=1025
SMTP_HOST=
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@7oz.local
SMTP_FROM_NAME=7Oz Espresso Cafe
# Cafe inbox for public contact form (defaults to SMTP_FROM_EMAIL when empty)
CONTACT_TO_EMAIL=hello@7oz.local

# Staging / production templates (copy, fill secrets, do not commit):
#   .env.staging.example -> .env.staging
#   .env.production.example -> .env.production
