# Production environment template — copy to `.env.production` on the VPS.
# Never commit real secrets. Prefer IMAGE_TAG=git-sha or semver (never latest).
# Complete docs/deployment/PRODUCTION_CUTOVER.md before go-live.

APP_ENV=production
APP_NAME=7oz-cafe
APP_URL=https://7oz-espresso.com
# Bind compose nginx to localhost when host Nginx/Certbot terminates TLS.
HTTP_PORT=127.0.0.1:8089
IMAGE_TAG=

NEXT_PUBLIC_APP_URL=https://7oz-espresso.com
NEXT_PUBLIC_ADMIN_URL=https://admin.7oz-espresso.com
NEXT_PUBLIC_API_URL=https://7oz-espresso.com/api/v1
CORS_ALLOWED_ORIGINS=https://7oz-espresso.com,https://www.7oz-espresso.com,https://admin.7oz-espresso.com

DB_USER=sevenoz
DB_PASSWORD=replace-with-strong-production-password
DB_NAME=sevenoz
# disable for compose-internal Postgres; use require for remote TLS Postgres.
DB_SSLMODE=disable

REDIS_PASSWORD=

JWT_ACCESS_SECRET=replace-with-production-access-secret-min-32-chars
JWT_REFRESH_SECRET=replace-with-production-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

WEBSITE_URL=https://7oz-espresso.com
SMTP_HOST=replace-with-smtp-host
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@7oz-espresso.com
SMTP_FROM_NAME=7Oz Espresso Cafe
CONTACT_TO_EMAIL=hello@7oz-espresso.com

BACKEND_IMAGE=ghcr.io/echestratus/7oz-backend
WEBSITE_IMAGE=ghcr.io/echestratus/7oz-website
ADMIN_IMAGE=ghcr.io/echestratus/7oz-admin
