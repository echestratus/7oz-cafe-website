# Staging environment template — copy to `.env.staging` (never commit secrets).

APP_ENV=staging
APP_NAME=7oz-cafe
APP_URL=https://stage.example.com
# Bind compose nginx to localhost when a host reverse proxy terminates TLS.
HTTP_PORT=127.0.0.1:8088
IMAGE_TAG=staging

NEXT_PUBLIC_APP_URL=https://stage.example.com
NEXT_PUBLIC_ADMIN_URL=https://stage.example.com/admin
NEXT_PUBLIC_API_URL=https://stage.example.com/api/v1
CORS_ALLOWED_ORIGINS=https://stage.example.com

DB_USER=sevenoz
DB_PASSWORD=replace-with-strong-staging-password
DB_NAME=sevenoz
DB_SSLMODE=disable

REDIS_PASSWORD=

JWT_ACCESS_SECRET=replace-with-staging-access-secret-min-32-chars
JWT_REFRESH_SECRET=replace-with-staging-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

WEBSITE_URL=https://stage.example.com
# Default staging mail sink (docker-compose.staging.yml mailpit service).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@7oz.example
SMTP_FROM_NAME="7Oz Espresso Cafe"
CONTACT_TO_EMAIL=hello@7oz.example

BACKEND_IMAGE=ghcr.io/echestratus/7oz-backend
WEBSITE_IMAGE=ghcr.io/echestratus/7oz-website
ADMIN_IMAGE=ghcr.io/echestratus/7oz-admin
